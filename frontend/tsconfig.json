{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
